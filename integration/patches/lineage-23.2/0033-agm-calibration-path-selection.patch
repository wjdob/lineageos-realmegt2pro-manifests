+/* Full directory override for products with ODM calibration packaging. */
+#ifndef AGM_ACDB_PATH
+#define AGM_ACDB_PATH ""
+#endif
+
+static int select_acdb_path(char *destination, size_t capacity,
+                           const char *path_override, const char *card_extn,
+                           int soc_id)
+{
+    int length;
+
+    if (path_override[0] != '\0') {
+        length = snprintf(destination, capacity, "%s", path_override);
+    } else if (soc_id == ARRAX_SOC_ID) {
+        length = snprintf(destination, capacity, "%s%s%s", ACDB_PATH,
+                          card_extn, ARRAX_FILE_PATH_EXTN);
+    } else {
+        length = snprintf(destination, capacity, "%s%s", ACDB_PATH, card_extn);
+    }
+
+    if (length < 0)
+        return -EINVAL;
+    return (size_t)length >= capacity ? -ENAMETOOLONG : 0;
+}
